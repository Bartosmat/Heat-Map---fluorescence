# --- Function to plot heatmap with log transformation ---
plot_heatmap_log <- function(data_vector, day_name){
  n_rows <- 6
  n_cols <- length(data_vector)/n_rows
  data_matrix <- matrix(data_vector, nrow = n_rows, byrow = TRUE)
  
  data_long <- melt(data_matrix)
  colnames(data_long) <- c("X", "Y", "Fluorescence")
  
  # Y-axis inversion
  data_long$Y <- max(data_long$Y) - data_long$Y + 1
  
  ggplot(data_long, aes(X, Y, fill = Fluorescence)) +
    geom_tile(color = "black") +
    scale_fill_gradient(
      low = "#e5f5e0",
      high = "#006d2c",
      trans = "log10",   # logarithmic scale
      name = "Fluorescence"
    ) +
    coord_fixed() +
    theme_minimal() +
    labs(
      title = paste("Fluorescence heatmap – JN2 mock", day_name),
      x = "Column",
      y = "Row"
    )
}

